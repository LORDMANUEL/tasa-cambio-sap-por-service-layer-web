#!/bin/sh
set -eu
APP=/opt/atas
DATA=/var/lib/atas
LOG=/var/log/atas
CONF=/etc/atas
USER=atas

if ! id "$USER" >/dev/null 2>&1; then
  adduser --system --group --home "$DATA" --no-create-home "$USER"
fi

mkdir -p "$DATA/uploads" "$LOG" "$CONF"
if [ ! -f "$CONF/app.env" ]; then cp "$APP/.env.example" "$CONF/app.env"; fi
rm -rf "$APP/data" "$APP/logs" "$APP/app/static/uploads"
ln -s "$DATA" "$APP/data"
ln -s "$LOG" "$APP/logs"
ln -s "$DATA/uploads" "$APP/app/static/uploads"
rm -f "$APP/.env"
ln -s "$CONF/app.env" "$APP/.env"

python3 -m venv "$APP/.venv"
"$APP/.venv/bin/python" -m pip install --upgrade pip
"$APP/.venv/bin/python" -m pip install --disable-pip-version-check -r "$APP/requirements.txt"

chown -R "$USER:$USER" "$DATA" "$LOG"
chown "$USER:$USER" "$CONF/app.env"
chmod 600 "$CONF/app.env"

systemctl daemon-reload
systemctl enable atas.service >/dev/null 2>&1 || true
systemctl restart atas.service || true
exit 0
