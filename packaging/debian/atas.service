[Unit]
Description=Atas V5 - SAP Business One FX automation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atas
Group=atas
WorkingDirectory=/opt/atas
Environment=PYTHONUNBUFFERED=1
Environment=SAPFX_FERNET_KEY_FILE=/var/lib/atas/.credential.key
ExecStart=/opt/atas/.venv/bin/python -m app.run_server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/atas /var/log/atas /etc/atas

[Install]
WantedBy=multi-user.target
